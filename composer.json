{
  "name": "besnovatyj/yii2-cms-tags",
  "description": "Общие теги для Yii2 CMS: один словарь и одна таблица связей на все контентные модули, форма назначения тегов, админка, страница тега и облако на фронте. Модули подключаются через контракт TaggableProvider.",
  "type": "yii2-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "Besnovatyj",
      "email": "your-email@example.com"
    }
  ],
  "minimum-stability": "stable",
  "extra": {
    "moduleClass": "Besnovatyj\\Tags\\Module",
    "moduleId": "Tags",
    "bescms": { "kind": "module" },
    "config-plugin": {
      "admin-menu": "src/config/adminMenu.php",
      "common": "src/config/common.php"
    }
  },
  "keywords": [
    "yii2",
    "cms",
    "tags",
    "taxonomy"
  ],
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "fxp-asset": {
      "enabled": false
    }
  },
  "require": {
    "php": ">=8.4",
    "ext-mbstring": "*",
    "yiisoft/yii2": "~2.0.0",
    "yiisoft/yii2-bootstrap5": "~2.0.0",
    "besnovatyj/yii2-cms-kernel": "^1.0",
    "besnovatyj/yii2-cms-contracts": "^1.0",
    "besnovatyj/yii2-cms-forms": "^1.0",
    "besnovatyj/yii2-cms-helpers": "^1.0",
    "besnovatyj/yii2-cms-validators": "^1.0",
    "besnovatyj/yii2-cms-backend-widgets": "^1.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "Besnovatyj\\Tags\\": "src/"
    }
  }
}
